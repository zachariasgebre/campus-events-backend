@baseUrl = http://localhost:3001/api
@email = jwt-student@example.edu
@password = CampusStudent7!
# Paste the returned tokens into these variables after login/refresh.
@accessToken = replace-with-access-token
@refreshToken = replace-with-refresh-token

### Public registration (201)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

### Registration rejects privileged client roles (400)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "email": "admin@example.edu", "password": "{{password}}", "roles": ["admin"] }

### Duplicate registration (409 after successful registration)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

### Public login (200)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

### Wrong password (401)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "WrongPassword7!" }

### Protected profile without token (401)
GET {{baseUrl}}/auth/me

### Protected profile with access token (200)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

### Protected events list (200 with token)
GET {{baseUrl}}/events
Authorization: Bearer {{accessToken}}

### Rotate refresh token (200); replace both variables with returned values
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }

### Logout (200)
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{accessToken}}

### Refresh after logout (401)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshToken}}" }
